# deploy/.env - this server's settings for compose.yaml. Copy to .env.
# Not committed (it's in .gitignore), and neither are api_key and hf_token.

# This server's address on your network (not 0.0.0.0): the ports listen there only.
LUNA_BIND=192.168.1.50

# Her chat model, from Hugging Face: <user>/<repo>[:quant]. Downloaded once.
MODEL_HF=bartowski/Qwen_Qwen3.5-9B-GGUF:Q4_K_M
# The side models (these are the defaults).
#EMBED_HF=Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
#RERANK_HF=ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF:Q8_0

# Her voice: the one config.json's "voice" says on the client.
#VOICE=af_bella

# As in llama/server.env: context, GPU layers, the reranker's GPU layers.
#CTX=16384
#NGL=99
#RERANK_NGL=99
# MMPROJ=off turns vision off.
#MMPROJ=

# The images (the GPU file you use sets these; override for CUDA 12):
#LLAMA_TAG=server-cuda
#LLAMA_DIGEST=sha256:490d8cd8000203a3ab8fdfce14ef931e2aa85affd4dd4447bcc75f299f00fd9a
#LLAMA_BUILD=cuda
#TORCH_INDEX=https://download.pytorch.org/whl/cu126

# Your Hugging Face token for gated models, if it lives elsewhere:
#HF_TOKEN_FILE=/home/you/.cache/huggingface/token

# The key the client needs (python -m services setup --server makes one):
#   ( umask 077; head -c 32 /dev/urandom | base64 | tr -d '/+=\n' > api_key )
