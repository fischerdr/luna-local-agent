# NVIDIA GPU — uses the RTX 3070 for faster synthesis.
# Base: nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04 (works with CUDA 13.0 drivers)
FROM nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04

# espeak-ng + pip
RUN apt-get update && apt-get install -y --no-install-recommends \
    espeak-ng python3-pip && rm -rf /var/lib/apt/lists/*

# Full PyTorch (CUDA-enabled)
RUN pip install --no-cache-dir \
    torch \
    ctranslate2 \
    kokoro>=0.9.4 \
    numpy>=1.24 \
    soundfile

WORKDIR /opt/kokoro-reader/server

# Force CUDA device — kokoro will use the GPU
ENV KOKORO_HOST=0.0.0.0 \
    KOKORO_PORT=8899 \
    KOKORO_LANG=a \
    KOKORO_DEVICE=cuda \
    KOKORO_VOICE=am_adam

EXPOSE 8899

COPY kokoro_server.py blends.json start_server.sh ./

CMD ["python", "kokoro_server.py"]
