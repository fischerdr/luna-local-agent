# NVIDIA GPU — uses the RTX 3070 for faster synthesis.
# Base: nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04 (works with CUDA 13.0 drivers)
FROM nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04

# git (for cloning kokoro-reader) + espeak-ng + pip
# Remove EXTERNALLY-MANAGED so pip works without --break-system-packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    git espeak-ng python3-pip && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/lib/python3.12/EXTERNALLY-MANAGED \
    && rm -f /usr/local/lib/python3.12/EXTERNALLY-MANAGED 2>/dev/null; true

# Clone kokoro-reader server files
RUN git clone --depth 1 https://github.com/fswolf/kokoro-reader.git /opt/kokoro-reader

# Full PyTorch (CUDA-enabled)
# --break-system-packages: standard in Docker since the container IS the environment
RUN pip install --no-cache-dir --break-system-packages \
    torch \
    ctranslate2 \
    kokoro>=0.9.4 \
    numpy>=1.24 \
    soundfile

WORKDIR /opt/kokoro-reader/server

# Force CUDA device — kokoro will use the GPU
ENV KOKORO_HOST=0.0.0.0 \
    KOKORO_PORT=8899 \
    KOKORO_LANG=a \
    KOKORO_DEVICE=cuda \
    KOKORO_VOICE=am_adam

EXPOSE 8899

CMD ["python3", "kokoro_server.py"]
