# Settings for running Luna's backend in containers (python -m services).
# Read after llama/server.env and server.local.env, so everything there
# - EMBED, RERANK, MMPROJ, CTX, NGL, the ports, HOST - still decides; this
# file only adds what the containers need besides. Your own overrides go
# in services/services.local.env, which isn't committed.

# --- Models from Hugging Face, downloaded once into the luna-models volume.
# <user>/<repo>[:quant], as llama-server's -hf takes it. Empty = use a
# file instead (MODEL / *_MATCH from server.env, under LUNA_MODELS_DIR).
MODEL_HF=""
# A vision adapter from another repo, as <user>/<repo>/<file>.gguf. Empty
# = the model's own (an -hf repo brings its mmproj by itself).
MMPROJ_HF=""
EMBED_HF="Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0"
RERANK_HF="ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF:Q8_0"

# --- Your own GGUFs: a folder mounted read-only at /models-host, so LM
# Studio's models (or llama/models) are used where they are, with no
# second copy. Empty = none. MODEL and MATCH patterns search it.
LUNA_MODELS_DIR=""

# --- Where each side model runs: GPU layers, 0 = CPU. The GPU goes to
# chat and her voice first; the embedder and reranker get it only when
# there's room left (python -m services bench measures it, and setup
# offers to run it), and otherwise run on the CPU.
EMBED_NGL=0
RERANK_NGL=0

# --- Which image: auto picks from the GPU (cuda, cuda13, rocm, vulkan),
# else cpu. Or one of: cpu cuda cuda13 rocm vulkan.
LLAMA_BACKEND=auto

# Where the voice runs: auto = the GPU when it's NVIDIA (with its CDI
# spec), else the CPU, which speaks faster than real time anyway. Or
# cpu, or cuda. A small card may want cpu, to leave its VRAM to chat.
TTS_DEVICE=auto

# The embedder and reranker on demand: started when a turn first wants
# them (that turn falls back as without them; the next finds them), and
# stopped after this many idle seconds. Off: they run with the rest.
EMBED_ONDEMAND=off
EMBED_IDLE=600
RERANK_IDLE=600

# How long up waits for a role to answer, in seconds. The first start
# of an -hf model includes its download.
READY_TIMEOUT=600
